{
  "name": "joslyne-vercel-cms",
  "version": "1.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && node prisma/seed.js && next dev",
    "build": "prisma generate && prisma migrate deploy && node prisma/seed.js && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "vitest run",
    "reset-admin-password": "node scripts/reset-admin-password.js"
  },
  "dependencies": {
    "@prisma/client": "^6",
    "@vercel/blob": "latest",
    "bcryptjs": "latest",
    "jose": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "slugify": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prisma": "^6",
    "vitest": "latest"
  }
}
